# /etc/ssh/sshd_config
# Managed by Ansible — do not edit this file manually.
# All values come from roles/hardening/vars/main.yml.
# To apply changes: ansible-playbook site.yml -t hardening_ssh
#
# with real values from vars/main.yml when Ansible renders it.
# The rendered output is a plain text config file — sshd never

# ── Network ───────────────────────────────────────────────────────
Port {{ ssh_port }}
# The port sshd listens on.
# UFW also has an allow rule for this port — both must match.

AddressFamily inet
# inet = IPv4 only.
# We disabled IPv6 system-wide, so there is no point binding to
# IPv6 addresses. inet prevents sshd from even trying.

ListenAddress 0.0.0.0
# 0.0.0.0 = listen on all IPv4 interfaces.
# UFW controls who can actually reach this port — sshd itself
# does not restrict by source IP.

# ── Authentication ────────────────────────────────────────────────
PermitRootLogin {{ ssh_permit_root_login }}
# "no" for lab machines — root should not be reachable via SSH.
# CS3-Infra uses "prohibit-password" because Ansible connects as root.

PasswordAuthentication {{ ssh_password_authentication }}
# "no" = keys only. Eliminates password brute force entirely.

PubkeyAuthentication yes
# Public key auth is the only allowed method.

AuthorizedKeysFile .ssh/authorized_keys
# Standard location for a user's authorized public keys.

PermitEmptyPasswords no
# Never allow login with a blank password under any circumstances.

ChallengeResponseAuthentication no
# Disable keyboard-interactive / PAM password prompts.
# Even with PasswordAuthentication no, some PAM configurations
# can sneak a password prompt through via this mechanism.
# Setting both closes the gap.

UsePAM yes
# Keep PAM enabled for account management and session setup.
# PAM handles things like login recording and session limits
# even without password authentication.

# ── Access control ────────────────────────────────────────────────
# No AllowUsers set here — lab machines should allow any valid user.
# In production (like CS3-Infra) you would add:
#   AllowUsers cs3admin cs3rescue
# to whitelist specific accounts at the SSH level.

# ── Security ──────────────────────────────────────────────────────
X11Forwarding {{ ssh_x11_forwarding }}
# "no" = no GUI forwarding. Not needed, reduces attack surface.

MaxAuthTries {{ ssh_max_auth_tries }}
# Disconnect after this many failed auth attempts per connection.

LoginGraceTime {{ ssh_login_grace_time }}
# Disconnect unauthenticated connections after this many seconds.

StrictModes yes
# Check that key files and home directories have safe permissions
# before accepting them. Rejects world-readable private keys.

IgnoreRhosts yes
# Ignore .rhosts files — a legacy insecure authentication mechanism
# that trusted connections based on hostname, not cryptography.

HostbasedAuthentication no
# Disable host-based auth — another legacy mechanism.

# ── Session ───────────────────────────────────────────────────────
ClientAliveInterval {{ ssh_client_alive_interval }}
# Send a keepalive probe every N seconds.

ClientAliveCountMax {{ ssh_client_alive_count_max }}
# Drop the connection after N missed keepalives.
# Total idle timeout = interval × count = {{ ssh_client_alive_interval * ssh_client_alive_count_max }}s.

# ── Logging ───────────────────────────────────────────────────────
LogLevel VERBOSE
# VERBOSE logs the fingerprint of the key used for each login.
# Makes it easy to identify which key authenticated in auth.log.

SyslogFacility AUTH
# Write to the AUTH log facility → /var/log/auth.log on Kali/Debian.

# ── SFTP ──────────────────────────────────────────────────────────
Subsystem sftp /usr/lib/openssh/sftp-server
# Enable secure file transfer over the same SSH connection.
# Uses the same key auth — no separate configuration needed.
